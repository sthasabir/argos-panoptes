# Some ATS feeds emit "US-VA-McLean" / "USA-NY-New York" — country-state-city joined
# by hyphens, with no commas anywhere. The comma parser sees a single unrecognised
# token, cannot place it, and the reject-on-undecidable rule then discards a real US
# job as non-US: two Steampunk roles in McLean, VA were dropped exactly this way.
#
# Only the US form is matched positively. A non-US string in the same shape
# ("CA-ON-Toronto") deliberately falls through to the normal rules rather than being
# guessed at — it ends up undecidable, which already means rejected.
#
# The `[a-z]{2}` state group is what keeps real hyphenated city names out: "Winston-
# Salem" fails on the country group (7 letters), and "Dallas-Fort Worth" fails on the
# state group ("fort" is 4).
_ATS_GEO = re.compile(r"^(?:us|usa)-([a-z]{2})(?:-.+)?$", re.I)


def _ats_state(s: str) -> str | None:
    """'US-VA-McLean' -> 'va'. None when the string isn't in that shape."""
    m = _ATS_GEO.match((s or "").strip())
    code = m.group(1).lower() if m else None
    return code if code in US_STATES else None


# Metro-area phrasing LinkedIn uses instead of "City, ST": "San Francisco Bay Area",
# "New York City Metropolitan Area", "Greater Boston", "Dallas-Fort Worth Metroplex".
# Stripped so the city lookup sees the bare city name.
#
# This MUST stay above _us_status and be used by BOTH it and _region_status. It was
# once wired into the region check only, and the US check kept comparing raw tokens
# against US_CITIES — so "San Francisco Bay Area" and "Dallas-Fort Worth Metroplex"
# were unplaceable, and the reject-on-undecidable rule discarded plainly-US LinkedIn
# jobs as "non-US location". LinkedIn writes locations this way constantly.
_METRO_NOISE = re.compile(
    r"\b(greater|metropolitan\s+area|metro\s+area|metroplex|metropolitan|metro|area|"
    r"bay\s+area)\b", re.I)


def _city_key(part: str) -> str | None:
    """Reduce a location token to a key in US_CITY_STATE, or None."""
    # Periods first: "Greater St. Louis" has to reach the "st louis" entry.
    p = re.sub(r"\s+", " ", _METRO_NOISE.sub(" ", part.replace(".", ""))).strip(" -")
    # Twin-city metros name both anchors ("Dallas-Fort Worth Metroplex",
    # "Winston-Salem"); try the whole string first, then each half.
    for cand in [p, p.replace("-", " ")] + [
            c.strip() for c in re.split(r"[-/]", p) if c.strip()]:
        if cand in US_CITY_STATE:
            return cand
        # "new york city" -> "new york"; only after the direct hit, so "kansas city",
        # "oklahoma city" and "salt lake city" keep their own entries.
        if cand.endswith(" city") and cand[:-5] in US_CITY_STATE:
            return cand[:-5]
        # Trailing qualifiers the noise list doesn't cover ("San Francisco Bay" once
        # "Area" is gone). Drop one trailing word at a time, but never below two words
        # — a bare first word invites false hits like "Washington Heights" -> DC.
        words = cand.split()
        for n in range(len(words) - 1, 1, -1):
            if " ".join(words[:n]) in US_CITY_STATE:
                return " ".join(words[:n])
    return None


def _us_status(loc: str):
    """True = US, False = definitely not US, None = can't tell.

    Feeds use "City, ST" for the US and "City, Region, Country" for everywhere else,
    so part-count disambiguates the overloaded codes: "Bengaluru, Karnataka, IN" is
    India (3 parts, country last) while "Indianapolis, IN" is Indiana (2 parts, state
    last). Same trap with CA = California vs Canada.

    A bare token we don't recognise ("Denver", "Bangalore") returns None rather than
    False — guessing wrong here silently discards real US jobs, and Gate 2 reads the
    full JD and is told to reject non-US roles, so it resolves these with real context.
    """
    s = re.sub(r"\s+", " ", (loc or "").strip().lower())
    parts = [p.strip() for p in s.split(",") if p.strip()]
    if not parts:
        return None
    if _ats_state(s):
        return True                # "US-VA-McLean" and friends
    last = re.sub(r"[^a-z ]", "", parts[-1]).strip()
    if last in US_COUNTRY:
        return True
    # An explicit foreign country name ANYWHERE in the string settles it. Matched as a
    # whole word against the raw string, NOT against comma-separated parts: feeds emit
    # "Mississauga Ontario Canada" with no commas at all, which a part-wise check reads
    # as one unrecognised token. This must also run before the state check — "India, IN"
    # is only two parts, so the 3-part country rule below never fires and "IN" then
    # matches Indiana. That is how a Bangalore role scored 10.0 and was picked 148 times.
    if any(re.search(rf"(?:^|\s){re.escape(c)}(?:\s|$)", s) for c in NON_US_COUNTRIES):
        return False
    if any(p in NON_US_COUNTRIES for p in parts):
        return False
    if any(_city_key(p) for p in parts):
        return True
    # Order matters: the 3-part check MUST precede the state check. In
    # "Bengaluru, Karnataka, IN" the last slot is a COUNTRY (India), but "in" is also
    # Indiana's abbreviation — checking states first misreads it as US. Same for
    # "Toronto, ON, CA" vs California.
    if len(parts) >= 3:
        return False          # City, Region, Country — and the country isn't the US
    if last == "remote":
        return True           # LinkedIn/Tsenta feeds are US-geo-filtered upstream
    if last in US_STATES or last in US_STATE_NAMES:
        return True
    if len(parts) >= 2:
        return False          # explicit region that isn't a US state
    return None               # single unrecognised token — undecidable


def is_us_job(job: dict) -> bool:
    """Keep only if at least one location is positively identifiable as US.

    Jobs with NO location field at all still pass: the LinkedIn adapter is geo-filtered
    to the US via LINKEDIN_GEOID and never populates `locations`, so rejecting on absent
    data would discard that whole source.

    But when a job DOES carry location data and none of it resolves to the US, it is
    rejected rather than waved through. The permissive version let Vietnamese, French,
    Romanian and Canadian postings survive Gate 1 on unparseable address strings like
    "15 Tran Bach Dang An Khanh Ward". This search is US-only, so unrecognised beats
    unfiltered — a US posting in an obscure town is a cheaper loss than an application
    to Ho Chi Minh City.
    """
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    if not locs:
        return True
    return any(_us_status(l if isinstance(l, str) else str(l)) is True for l in locs)


REGION_ON = os.environ.get("REQUIRE_REGION", "1" if REQUIRE_REGION else "0") == "1"
REGION = {s.strip().lower() for s in os.environ.get(
    "REGION_STATES", ",".join(sorted(REGION_STATES))).split(",") if s.strip()}
REGION_REMOTE_OK = os.environ.get(
    "REGION_ALLOW_REMOTE", "1" if REGION_ALLOW_REMOTE else "0") == "1"

def _state_code(part: str) -> str | None:
    """'nj' / 'new jersey' -> 'nj'. None if the token isn't a state."""
    p = re.sub(r"[^a-z ]", "", part).strip()
    if p in US_STATES:
        return p
    return STATE_CODE.get(p)


def _region_status(loc: str):
    """True = in-region, False = definitely outside it, None = can't tell.

    Mirrors _us_status: a location we cannot positively place does NOT pass. The
    scan runs right-to-left because feeds put the state in the last slot, which is
    also what keeps "Washington, DC" from resolving as Washington state — 'dc' is
    read first. A bare "Washington" is deliberately left undecidable for that same
    collision (US_CITY_STATE maps it to dc, but the state name says wa).
    """
    s = re.sub(r"\s+", " ", (loc or "").strip().lower())
    parts = [p.strip() for p in s.split(",") if p.strip()]
    if not parts:
        return None
    if _us_status(loc) is False:
        return False                       # not in the US at all, so not in-region
    code = _ats_state(s)
    if code:
        return code in REGION              # "US-VA-McLean" carries its own state
    # 1) explicit state slot — rightmost state token wins
    if len(parts) >= 2:
        for p in reversed(parts):
            code = _state_code(p)
            if code:
                return code in REGION
    # 2) bare city name, with no state to disambiguate it
    for p in reversed(parts):
        key = _city_key(p)
        if key:
            st = US_CITY_STATE[key]
            return None if st is None else st in REGION
    if len(parts) == 1:
        code = _state_code(parts[0])
        if code:
            return code in REGION
    # 3) nationwide / remote postings: no metro named at all. "Remote", "Remote, US"
    #    and a bare "United States" are all workable from the East Coast, so they
    #    ride on REGION_ALLOW_REMOTE rather than being dropped as unplaceable.
    if re.search(r"\bremote\b|\banywhere\b", s) or all(
            re.sub(r"[^a-z ]", "", p).strip() in US_COUNTRY for p in parts):
        return True if REGION_REMOTE_OK else False
    return None


def is_in_region(job: dict) -> bool:
    """Keep only if at least one location is positively inside the target region.

    Jobs with NO location field pass, same as is_us_job — but that hole is much
    smaller than it was: the LinkedIn adapter now parses each card's location, and
    it was the source that populated nothing.
    """
    if not REGION_ON:
        return True
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    if not locs:
        return True
    return any(_region_status(l if isinstance(l, str) else str(l)) is True for l in locs)


SALARY_FLOOR = float(os.environ.get("MIN_SALARY", MIN_SALARY))
SALARY_BASE = float(os.environ.get("SALARY_BASELINE", SALARY_BASELINE))
LOCATION_ADJUST = os.environ.get(
    "SALARY_LOCATION_ADJUST", "1" if SALARY_LOCATION_ADJUST else "0") == "1"


def _location_multiplier(loc: str) -> float | None:
    """Cost index for one location string, or None if it can't be placed.

    Reuses the same resolution the location filters use, so "Jersey City, NJ",
    "New York City Metropolitan Area" and "US-NY-New York" all land correctly.
    City beats state: NYC is 1.37 while the rest of New York is not, and
    Philadelphia carries a city wage tax the rest of Pennsylvania does not.
    """
    s = re.sub(r"\s+", " ", (loc or "").strip().lower())
    parts = [p.strip() for p in s.split(",") if p.strip()]
    for p in parts:
        key = _city_key(p)
        if key and key in SALARY_LOCATION_INDEX_CITY:
            return SALARY_LOCATION_INDEX_CITY[key]
    code = _ats_state(s)
    if not code and len(parts) >= 2:
        for p in reversed(parts):
            code = _state_code(p)
            if code:
                break
    if not code:
        for p in reversed(parts):
            key = _city_key(p)
            if key:
                code = US_CITY_STATE[key]
                break
    if not code and len(parts) == 1:
        code = _state_code(parts[0])
    return SALARY_LOCATION_INDEX.get(code) if code else None


def effective_floor(job: dict) -> float:
    """The salary bar this particular job has to clear.

    Never below MIN_SALARY: a cheap metro does not buy a discount. Among several
    locations the LOWEST index wins, matching is_in_region()'s any() semantics — the
    posting is judged by the cheapest place it could put you, and Gate 2 reads the JD
    for the real one. Unplaceable locations and remote roles use the flat floor;
    remote deliberately, since it can be worked from the current low-cost metro.
    """
    if not LOCATION_ADJUST or SALARY_FLOOR <= 0:
        return SALARY_FLOOR
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    mults = [m for m in (_location_multiplier(str(l)) for l in (locs or [])) if m]
    if not mults:
        return SALARY_FLOOR
    return max(SALARY_FLOOR, SALARY_BASE * min(mults))


def _money(v) -> float | None:
    """Feeds send salaries as strings ('125760', '125,760', '$125760') or numbers."""
    if v in (None, "", 0):
        return None
    try:
        return float(re.sub(r"[^0-9.]", "", str(v)) or 0) or None
    except ValueError:
        return None


def pays_enough(job: dict) -> bool:
    """False only when the posting's own numbers prove it can't clear the floor.

    Uses the TOP of the range: a "$55,000 - $152,375" listing is a real posting here,
    and its floor reflects a junior/low-cost-metro hire, not the ceiling on offer.
    Non-USD and missing salaries pass — about half the feed has no salary at all.
    """
    if SALARY_FLOOR <= 0:
        return True
    cur = (job.get("salaryCurrency") or "USD").upper()
    if cur not in ("USD", "US$", "$"):
        return True
    top = _money(job.get("salaryMax")) or _money(job.get("salaryMin"))
    if top is None:
        return True
    # Some feeds post hourly rates; treat anything implausibly small as an hourly
    # figure and annualise at 2,080 hours rather than dropping a good contract role.
    if top < 1000:
        top *= 2080
    return top >= effective_floor(job)


ASK_PCT = float(os.environ.get("ASK_PERCENTILE", ASK_PERCENTILE))


def suggested_ask(job: dict) -> float:
    """What to put in the salary field for THIS posting.

    The rule, in order:
      1. (enforced by pays_enough) skip anything whose TOP is below the floor
      2. ask = bottom + ASK_PERCENTILE x (top - bottom)
      3. never below MIN_SALARY
      4. NEVER above the top of the posted range
      5. no range published -> MIN_SALARY

    Step 4 is the one that matters most in practice. Without it a flat ask of $145,000
    went out against a posting topping out at $143,000 — $2,000 over their published
    maximum, which most ATS screens treat as an automatic disqualification.

    A very wide band ($114k-$218k) usually spans several job levels, so a high result
    is a starting hypothesis for a human, not a number to submit unexamined.
    """
    hi, lo = _money(job.get("salaryMax")), _money(job.get("salaryMin"))
    if not hi and not lo:
        return float(STATED_ASK)                       # rule 5
    hi, lo = hi or lo, lo or hi
    if hi < 1000:                      # hourly rate posted; annualise as pays_enough does
        lo, hi = lo * 2080, hi * 2080
    ask = round((lo + ASK_PCT * (hi - lo)) / 1000) * 1000   # rule 2
    ask = max(ask, effective_floor(job))                    # rule 3
    return min(ask, hi)                                     # rule 4


# ---------------------------------------------------------------- citizenship
# The candidate is a U.S. Permanent Resident, not a citizen. Federal contract work
# frequently requires citizenship OUTRIGHT, with no clearance involved — so the
# clearance dealbreaker in gate2 never fires on it. Edgewater Federal Solutions
# ("This is a remote position and US citizenship is required per contract") was
# applied to on 2026-08-14 for exactly that reason.
#
# This runs on the DESCRIPTION, so it cannot live in gate1's structured pass — the
# pipeline calls it after the JD fetch, before scoring.
_CITIZEN_REQ = re.compile(
    r"(?:u\.?s\.?|united states)\s+citizenship\s+(?:is\s+)?(?:required|mandatory)"
    r"|must\s+be\s+a\s+(?:u\.?s\.?|united states)\s+citizen"
    r"|u\.?s\.?\s+citizens?\s+only"
    r"|citizenship\s+is\s+required"
    r"|sole\s+u\.?s\.?\s+citizenship", re.I)
# Postings that name citizenship but explicitly accept permanent residents are FINE —
# "Candidates must be a US Citizen or Green Card Holder" (Worldpay), "US Citizen or
# Permanent Resident" (Laansu). Checked within the same sentence, because a green-card
# mention three paragraphs away in an EEO boilerplate proves nothing.
_PR_OK = re.compile(
    r"permanent\s+resident|green\s*card|lawful\s+permanent|\bLPR\b|"
    r"authorized\s+to\s+work", re.I)

REQUIRE_CITIZENSHIP_CHECK = os.environ.get("BLOCK_CITIZENSHIP_ONLY", "1") == "1"


def requires_citizenship(text: str) -> bool:
    """True when the posting demands citizenship AND does not accept a green card.

    Sentence-scoped: a sentence that says "must be a U.S. citizen or permanent
    resident" is acceptable, while "US citizenship is required per contract" is not.
    """
    if not REQUIRE_CITIZENSHIP_CHECK or not text:
        return False
    plain = re.sub(r"<[^>]+>", " ", text)
    # Collapse "U.S." / "U. S." / "U.S.A." to "US" BEFORE splitting on sentence
    # punctuation — otherwise "must be a U.S. citizen" is torn into "must be a U.",
    # "S." and "citizen.", and the requirement is never seen whole.
    plain = re.sub(r"\bU\.\s*S\.\s*A\.", "USA", plain, flags=re.I)
    plain = re.sub(r"\bU\.\s*S\.", "US", plain, flags=re.I)
    plain = re.sub(r"\s+", " ", plain)
    for sentence in re.split(r"(?<=[.!?;])\s+", plain):
        if _CITIZEN_REQ.search(sentence) and not _PR_OK.search(sentence):
            return True
    return False


# ---------------------------------------------------------------- education
# The candidate holds a Bachelor of Information Technology. Postings that REQUIRE a
# Master's or PhD are out (requested 2026-08-15) — Zoom's real listing, for example,
# opens "Requires a Master's degree in Computer Science... or a foreign degree
# equivalent", with no bachelor's alternative.
#
# The whole difficulty is required vs preferred. "Bachelor's required, Master's
# preferred" is the single most common phrasing in this feed and must NOT be blocked,
# so the check is sentence-scoped and looks for a bachelor's-level alternative in the
# same sentence.
_ADVANCED_REQ = re.compile(
    r"(?:master'?s?|m\.?s\.?c?|ph\.?\s?d|doctorate|doctoral|advanced\s+degree|"
    r"graduate\s+degree)\b[^.]{0,60}\b(?:is\s+)?(?:required|mandatory|must)"
    r"|(?:requires?|must\s+(?:have|possess)|minimum\s+of)\b[^.]{0,40}"
    r"\b(?:master'?s?|ph\.?\s?d|doctorate|advanced\s+degree|graduate\s+degree)\b", re.I)
# A bachelor's-level alternative in the same sentence makes it acceptable.
_BACHELOR_OK = re.compile(
    r"bachelor|\bb\.?s\.?\b|\bb\.?a\.?\b|\bbsc\b|undergraduate|"
    r"or\s+equivalent|equivalent\s+(?:experience|work)|"
    r"or\s+\d+\+?\s*years", re.I)

REQUIRE_DEGREE_CHECK = os.environ.get("BLOCK_ADVANCED_DEGREE", "1") == "1"


def requires_advanced_degree(text: str) -> bool:
    """True when the posting demands a Master's/PhD with no bachelor's alternative."""
    if not REQUIRE_DEGREE_CHECK or not text:
        return False
    plain = re.sub(r"<[^>]+>", " ", text)
    plain = re.sub(r"\b(M|B|Ph)\.\s*([A-Z])\.", r"\1\2", plain)   # M.S. -> MS, Ph.D -> PhD
    plain = re.sub(r"\s+", " ", plain)
    for sentence in re.split(r"(?<=[.!?;])\s+|•|\n", plain):
        if _ADVANCED_REQ.search(sentence) and not _BACHELOR_OK.search(sentence):
            return True
    return False


# ---------------------------------------------------------------- non-US description
# is_us_job() waves through postings with an EMPTY `locations` array — 42% of gate-1
# survivors, so rejecting them wholesale would gut the funnel. That hole let Moniepoint
# ("Africa's all-in-one financial ecosystem... Nigeria's largest merchant acquirer",
# locations=[], workplaceType=REMOTE) reach an application on 2026-08-17.
#
# This is the narrow backstop: a foreign country or foreign tech hub named in the
# posting's OPENING (where the company describes itself and its location), with no US
# signal anywhere in the text. Deliberately not "require proof of US" — that measured at
# only 2 of 11 no-location jobs, and would have cost a third of all supply.
_INTRO_CHARS = 800
_FOREIGN_PLACE = re.compile(
    r"\b(" + "|".join(sorted(re.escape(c) for c in NON_US_COUNTRIES)) + r"|"
    r"africa|african|lagos|abuja|nairobi|bengaluru|bangalore|hyderabad|pune|gurgaon|"
    r"noida|chennai|mumbai|delhi|toronto|vancouver|montreal|london|dublin|berlin|"
    r"munich|paris|madrid|lisbon|amsterdam|warsaw|krakow|bucharest|sao paulo|"
    r"buenos aires|bogota|mexico city|tel aviv|dubai|singapore|sydney|melbourne|"
    r"tokyo|seoul|shanghai|beijing|manila|jakarta|ho chi minh|hanoi)\b", re.I)
_US_SIGNAL = re.compile(
    r"\b(united states|u\.?s\.?a\.?|\bus\b|us[- ]based|us remote|remote[ -]us|"
    + "|".join(sorted(re.escape(s) for s in US_STATE_NAMES)) + r")\b", re.I)

BLOCK_NON_US_DESC = os.environ.get("BLOCK_NON_US_DESCRIPTION", "1") == "1"


def describes_non_us(text: str) -> bool:
    """True when the posting reads as based outside the US and never mentions the US."""
    if not BLOCK_NON_US_DESC or not text:
        return False
    plain = re.sub(r"<[^>]+>", " ", text)
    plain = re.sub(r"\s+", " ", plain)
    if _US_SIGNAL.search(plain):
        return False                      # any US signal anywhere clears it
    return bool(_FOREIGN_PLACE.search(plain[:_INTRO_CHARS]))


# ---------------------------------------------------------------- clearance
# US security clearances (Confidential / Secret / Top Secret / TS-SCI) require US
# CITIZENSHIP. A permanent resident cannot hold one and cannot be sponsored for one, so
# "must be able to obtain" is just as disqualifying as "must currently hold".
#
# PUBLIC TRUST is the deliberate exception: it is a suitability investigation, not a
# clearance, and permanent residents are eligible — Laansu's posting spells that out
# ("clearable for a Public Trust Position - must be a US Citizen or Permanent Resident").
_CLEARANCE = re.compile(
    r"\b(ts/sci|ts-sci|top\s+secret|secret\s+clearance|security\s+clearance|"
    r"polygraph|\bpoly\b|counterintelligence\s+poly|full\s+scope\s+poly|"
    r"dod\s*8570|sci\s+eligib|clearance\s+(?:is\s+)?required|active\s+clearance|"
    r"cleared\s+facility|q\s+clearance|l\s+clearance)\b", re.I)
# A sentence that only mentions Public Trust is fine.
_PUBLIC_TRUST_ONLY = re.compile(r"public\s+trust", re.I)

# Titles that advertise the requirement up front — caught in gate1, before any JD fetch.
TITLE_CLEARANCE = re.compile(
    r"\(\s*cleared\s*\)|\bcleared\b|\bts/sci\b|\btop\s+secret\b|\bsecret\s+clearance\b|"
    r"\bpolygraph\b|\bpoly\s*\)|\bsecret\b\s*\)", re.I)

BLOCK_CLEARANCE = os.environ.get("BLOCK_CLEARANCE", "1") == "1"


def requires_clearance(text: str) -> bool:
    """True when the posting needs a US security clearance. Public Trust is allowed."""
    if not BLOCK_CLEARANCE or not text:
        return False
    plain = re.sub(r"<[^>]+>", " ", text)
    plain = re.sub(r"\s+", " ", plain)
    for sentence in re.split(r"(?<=[.!?;])\s+|•|\n", plain):
        m = _CLEARANCE.search(sentence)
        if not m:
            continue
        # "Clearance Requirement: Public Trust" and similar are acceptable
        if _PUBLIC_TRUST_ONLY.search(sentence) and not re.search(
                r"ts/sci|top\s+secret|secret\s+clearance|polygraph", sentence, re.I):
            continue
        return True
    return False


EXCLUDE_LEAD = os.environ.get("EXCLUDE_LEAD", "1") == "1"

FULL_TIME_ONLY = os.environ.get(
    "REQUIRE_FULL_TIME", "1" if REQUIRE_FULL_TIME else "0") == "1"
# Values that are NOT a permanent full-time role. Anything else (including a missing
# field) passes — see REQUIRE_FULL_TIME in profile.py for why.
NOT_FULL_TIME = {"CONTRACT", "CONTRACTOR", "CONTRACT_TO_HIRE", "C2H", "TEMPORARY", "TEMP",
                 "PART_TIME", "PARTTIME", "INTERNSHIP", "INTERN", "FREELANCE", "SEASONAL",
                 "APPRENTICESHIP", "VOLUNTEER"}
TITLE_CONTRACT = re.compile(
    r"\b(contract|contractor|c2c|corp\s*to\s*corp|w2\s*only|1099|"
    r"contract\s*to\s*hire|temp|temporary|part[\s-]time)\b", re.I)


def is_full_time(job: dict) -> bool:
    if not FULL_TIME_ONLY:
        return True
    et = re.sub(r"[^A-Z_]", "", (job.get("employmentType") or "").upper())
    if et in NOT_FULL_TIME:
        return False
    # Staffing listings often leave employmentType null and say it in the title instead.
    return not TITLE_CONTRACT.search(job.get("title") or "")


WORKPLACE_OK = {w.strip().upper() for w in os.environ.get(
    "ALLOWED_WORKPLACE", ",".join(sorted(ALLOWED_WORKPLACE))).split(",") if w.strip()}


HYBRID_OK_STATES = {s.strip().lower() for s in os.environ.get(
    "HYBRID_STATES", ",".join(sorted(HYBRID_STATES))).split(",") if s.strip()}
# City-level exceptions, for metros whose state is too coarse a proxy for "commutable".
HYBRID_OK_CITIES = {c.strip().lower() for c in os.environ.get(
    "HYBRID_CITIES", ",".join(sorted(HYBRID_CITIES))).split(",") if c.strip()}

# Every city on HYBRID_CITIES is in the Philadelphia metro, i.e. Pennsylvania. Without
# this the bare city name matched anywhere in the country: "Malvern, AR" (Arkansas,
# ~1,100 miles from Example City) satisfied the commute check on 2026-08-18 purely
# because a Malvern exists in both states. A city match now also has to agree with the
# state printed in the same location string.
HYBRID_CITY_STATES = {s.strip().lower() for s in os.environ.get(
    "HYBRID_CITY_STATES", "pa").split(",") if s.strip()}

# States the candidate will not relocate to for a hybrid role (2026-08-18). REMOTE is unaffected:
# a remote job whose company sits in New York costs no move, so only on-site-days roles
# are screened here.
HYBRID_NO_STATES = {s.strip().lower() for s in os.environ.get(
    "HYBRID_EXCLUDE_STATES", "ny,az").split(",") if s.strip()}


def _job_cities(job: dict) -> set:
    """Every recognised city key in the posting's locations."""
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    out = set()
    for l in (locs or []):
        for part in str(l).lower().split(","):
            k = _city_key(part.strip())
            if k:
                out.add(k)
    return out


def _job_states(job: dict) -> set:
    """Every US state code the posting's locations resolve to."""
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    out = set()
    for l in (locs or []):
        s = re.sub(r"\s+", " ", str(l).strip().lower())
        parts = [p.strip() for p in s.split(",") if p.strip()]
        code = _ats_state(s)
        if not code:
            for p in reversed(parts):
                code = _state_code(p)
                if code:
                    break
        if not code:
            for p in reversed(parts):
                k = _city_key(p)
                if k:
                    code = US_CITY_STATE[k]
                    break
        if code:
            out.add(code)
    return out


def _hybrid_city_ok(job: dict) -> bool:
    """True when some ONE location is both an allowed city and in an allowed state.

    Scanned per location rather than by intersecting job-wide city and state sets, so
    a posting listing "Malvern, PA" and "Charlotte, NC" is not admitted by pairing the
    city from one entry with the state from another. A location naming an allowed city
    with no state at all still passes -- bare "philadelphia" is unambiguous enough.
    """
    locs = job.get("locations")
    if isinstance(locs, str):
        locs = [locs]
    for l in (locs or []):
        one = {"locations": [l]}
        if not (_job_cities(one) & HYBRID_OK_CITIES):
            continue
        states = _job_states(one)
        if not states or states & HYBRID_CITY_STATES:
            return True
    return False


def workplace_ok(job: dict) -> bool:
    """Remote anywhere; hybrid only where the office is commutable; onsite never.

    A missing workplaceType passes, as it always has — a third of the feed omits it.
    HYBRID is the conditional case: it needs a location inside HYBRID_OK_STATES, and a
    hybrid posting whose location cannot be placed is rejected, because "hybrid
    somewhere unknown" is not a commute anyone can make.
    """
    if not WORKPLACE_OK:
        return True
    wt = re.sub(r"[^A-Z_]", "", (job.get("workplaceType") or "").upper())
    if not wt:
        return True
    if wt == "HYBRID" and HYBRID_NO_STATES:
        states = _job_states(job)
        # Only reject when EVERY placeable location is excluded. A posting offering
        # Columbus / Irving / Chandler still has two sites he would move to, so it
        # stays; one offering only New York does not.
        if states and states <= HYBRID_NO_STATES:
            return False
    if wt == "HYBRID" and (HYBRID_OK_STATES or HYBRID_OK_CITIES):
        return bool(_job_states(job) & HYBRID_OK_STATES
                    or _hybrid_city_ok(job))
    return wt in WORKPLACE_OK


def normalize_family(job: dict) -> str:
    rf = (job.get("roleFamily") or "").upper()
    return ROLE_FAMILY_MAP.get(rf, "other")


def _drop(job: dict, reason: str) -> dict:
    return {"id": job.get("id"), "title": job.get("title"),
            "company": job.get("companyName"), "reason": reason}


def gate1(jobs: list[dict]) -> tuple[list[dict], list[dict]]:
    kept, dropped = [], []
    for j in jobs:
        title = j.get("title") or ""
        level = (j.get("seniorityLevel") or "").strip().lower()
        yoe = j.get("yearsOfExperienceMin")
        sponsor = (j.get("sponsorship") or "").upper()

        # 0) never-apply company list (current employer, etc.) — checked first so
        #    nothing on the blocklist can reach the scorer, let alone the apply call.
        #    The TITLE is checked too: staffing/vendor listings name the real end
        #    client there while companyName is the vendor, e.g.
        #    "Vantage Capital - Java Full Stack Engineer" posted under companyName "Oracle".
        if is_blocked_company(j.get("companyName")):
            dropped.append(_drop(j, f"blocked company: {j.get('companyName')}")); continue
        if is_blocked_company(title):
            dropped.append(_drop(j, f"blocked company in title: {title}")); continue
        # 0a) staffing firms allowed only for remote/hybrid roles
        if is_remote_only_company(j.get("companyName")):
            wt = re.sub(r"[^A-Z_]", "", (j.get("workplaceType") or "").upper())
            if wt not in STAFFING_ALLOWED_WORKPLACE:
                dropped.append(_drop(j, f"staffing onsite: {j.get('companyName')} "
                                        f"[{j.get('workplaceType') or 'unspecified'}]")); continue
        # 0b) location — US / remote-US only
        if US_ONLY and not is_us_job(j):
            locs = j.get("locations")
            dropped.append(_drop(j, f"non-US location: {locs}")); continue
        # 0c) region — East Coast / Eastern time zone only. Runs after the US check so
        #     a foreign posting is reported as non-US rather than as out-of-region.
        if not is_in_region(j):
            dropped.append(_drop(j, f"outside region: {j.get('locations')}")); continue
        # 1) management / executive track — IC search
        if level in MANAGEMENT_LEVELS or TITLE_MANAGEMENT.search(title):
            dropped.append(_drop(j, f"management track: {title}")); continue
        # 1b) lead level and above — excluded by request
        if EXCLUDE_LEAD and TITLE_LEAD.search(title):
            dropped.append(_drop(j, f"lead-or-above: {title}")); continue
        # 1c) "Engineer II" band — below the target range
        if TITLE_LEVEL_TWO.search(title):
            dropped.append(_drop(j, f"level-II role: {title}")); continue
        # 1d) "Engineer IV" and above — above the target range
        if TITLE_LEVEL_FOUR_PLUS.search(title):
            dropped.append(_drop(j, f"level-IV-plus role: {title}")); continue
        # 2) intern / co-op / apprenticeship
        if TITLE_INTERN.search(title):
            dropped.append(_drop(j, f"intern/co-op: {title}")); continue
        # 3) explicitly entry-level / new-grad — below this candidate's band
        if REJECT_ENTRY_LEVEL and (level in JUNIOR_LEVELS or TITLE_ENTRY.search(title)):
            dropped.append(_drop(j, f"entry-level: {title}")); continue
        # 4) demands more experience than the candidate has
        if isinstance(yoe, (int, float)) and yoe > MAX_YOE:
            dropped.append(_drop(j, f"requires {yoe}+ YOE (cap {MAX_YOE:g})")); continue
        # 5) explicit no-sponsorship — only a dealbreaker if sponsorship is needed
        if NEEDS_SPONSORSHIP and sponsor in SPONSOR_NO:
            dropped.append(_drop(j, f"no sponsorship: {j.get('sponsorship')}")); continue
        # 5b) salary floor — only fires when the posting's own numbers rule it out
        if not pays_enough(j):
            dropped.append(_drop(j, f"below salary floor: {j.get('salaryMin')}-{j.get('salaryMax')}")); continue
        # 5c) full-time permanent only
        if not is_full_time(j):
            dropped.append(_drop(j, f"not full-time: {j.get('employmentType') or title}")); continue
        # 5d) remote/hybrid only — proxy for avoiding an in-person interview loop
        if not workplace_ok(j):
            dropped.append(_drop(j, f"onsite only: {j.get('workplaceType')}")); continue
        # 5e) clearance advertised in the title — no citizenship, no clearance
        if BLOCK_CLEARANCE and TITLE_CLEARANCE.search(title):
            dropped.append(_drop(j, f"clearance in title: {title}")); continue
        # 6) basic-IT / non-eng
        if TITLE_BASIC_IT.search(title):
            dropped.append(_drop(j, f"basic-IT/non-eng: {title}")); continue
        # 7) must look CS-relevant
        if not TITLE_CS_RELEVANT.search(title):
            dropped.append(_drop(j, f"not CS-relevant: {title}")); continue

        kept.append(j)
    return kept, dropped
