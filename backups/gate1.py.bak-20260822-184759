_BLOCKED = [c.strip().lower() for c in os.environ.get(
    "EXCLUDE_COMPANIES", "|".join(EXCLUDE_COMPANIES)).split("|") if c.strip()]


def _norm_company(name: str) -> str:
    """Lowercase, drop punctuation and corporate suffixes, collapse whitespace, so
    'Meridian Financial Corp.' and 'Meridian Financial' compare equal-ish."""
    s = re.sub(r"[^a-z0-9]+", " ", (name or "").lower())
    s = re.sub(r"\b(inc|llc|ltd|corp|corporation|co|plc|group|holdings|technologies|"
               r"solutions|services|and)\b", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def _matches_any(name: str, patterns) -> bool:
    """Whole-word/phrase match on the normalized company name, so 'Chase' matches
    'Chase Bank' but not 'Chaser Systems'."""
    norm = _norm_company(name)
    if not norm:
        return False
    return any(re.search(rf"(?:^|\s){re.escape(_norm_company(p))}(?:\s|$)", norm)
               for p in patterns if _norm_company(p))


def is_blocked_company(name: str) -> bool:
    """True if the company is on the never-apply list."""
    return _matches_any(name, _BLOCKED)


def is_remote_only_company(name: str) -> bool:
    """Staffing firms acceptable only when the role is fully remote."""
    return _matches_any(name, STAFFING_REMOTE_ONLY)


